<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LGHS Imager"
        Width="900" Height="690" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#0F1115"
        FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#171A20"/>
    <SolidColorBrush x:Key="Panel2" Color="#1D2129"/>
    <SolidColorBrush x:Key="Border" Color="#2A303A"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6F8"/>
    <SolidColorBrush x:Key="Subtle" Color="#98A2B3"/>
    <SolidColorBrush x:Key="Accent" Color="#7DB4FF"/>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Background" Value="#252A33"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#343B47"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="LGHS Imager" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
        <TextBlock Text="Classroom deployment for Raspberry Pi 5 8GB" FontSize="13" Foreground="{StaticResource Subtle}" Margin="0,5,0,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#162235" BorderBrush="#29486E" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
        <TextBlock Text="PI 5  |  8 GB  |  ARM64" Foreground="#A9CBFF" FontSize="11" FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,0,0,20">
      <TextBlock Text="1  Choose deployment" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,7,0">
          <StackPanel>
            <RadioButton x:Name="StudentButton" Content="Student" GroupName="Mode" IsChecked="True"/>
            <TextBlock Text="Managed classroom image" Foreground="{StaticResource Subtle}" FontSize="12" Margin="24,6,0,0"/>
            <TextBlock Text="Auto numbers CS-01 through CS-14" Foreground="#6F7B8A" FontSize="11" Margin="24,3,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="7,0">
          <StackPanel>
            <RadioButton x:Name="ControlButton" Content="Control" GroupName="Mode"/>
            <TextBlock Text="Fleet controller image" Foreground="{StaticResource Subtle}" FontSize="12" Margin="24,6,0,0"/>
            <TextBlock Text="Hostname LGCSCONT" Foreground="#6F7B8A" FontSize="11" Margin="24,3,0,0"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="7,0,0,0">
          <StackPanel>
            <RadioButton x:Name="LocalButton" Content="Local image" GroupName="Mode"/>
            <TextBlock Text="Use an image from this PC" Foreground="{StaticResource Subtle}" FontSize="12" Margin="24,6,0,0"/>
            <TextBlock Text="For testing and recovery" Foreground="#6F7B8A" FontSize="11" Margin="24,3,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,20">
      <TextBlock Text="2  Review image and identity" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,18,0">
            <TextBlock Text="IMAGE" Foreground="#6F7B8A" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="ImageLabel" Text="LGHS Student" Foreground="{StaticResource Text}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <TextBlock Text="Raspberry Pi 5 8GB managed classroom image" Foreground="{StaticResource Subtle}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
          <Border Grid.Column="1" Width="1" Background="#2B313B"/>
          <StackPanel Grid.Column="2" Margin="18,0,0,0">
            <TextBlock Text="DEVICE ID" Foreground="#6F7B8A" FontSize="10" FontWeight="Bold"/>
            <TextBlock x:Name="TargetLabel" Text="CS-01" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock Text="Written to first-boot provisioning" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,20">
      <TextBlock Text="3  Select storage" Foreground="{StaticResource Text}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <ComboBox x:Name="DriveBox" Grid.Column="0" Height="38" Margin="0,0,10,0" FontSize="13"/>
          <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" MinWidth="90"/>
        </Grid>
      </Border>
    </StackPanel>

    <Border Grid.Row="4" Background="#12151A" BorderBrush="#242A33" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="StatusText" Text="Ready to write" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock Text="SHA-256 validation and post-write verification enabled" Foreground="{StaticResource Subtle}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
          <Button x:Name="DetailsButton" Grid.Column="1" Content="Show details" Padding="12,6" Background="Transparent" BorderBrush="#303742" Foreground="#AAB4C0"/>
        </Grid>
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="4" Margin="0,12,0,0" IsIndeterminate="False"/>
        <TextBox x:Name="LogBox" Grid.Row="2" Visibility="Collapsed" Margin="0,14,0,0" Height="125" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="#0A0C0F" Foreground="#CBD3DC" BorderBrush="#262C35" Padding="10"/>
      </Grid>
    </Border>

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="Selected storage will be erased" Foreground="#D2A36D" FontSize="11"/>
        <TextBlock Text="Telemetry is disabled in LGHS Imager" Foreground="#707A87" FontSize="10" Margin="0,3,0,0"/>
      </StackPanel>
      <Button x:Name="WriteButton" Grid.Column="1" Content="WRITE SD CARD" FontWeight="SemiBold" FontSize="13" Padding="24,12" Background="#2E6DB4" BorderBrush="#4D8BD1" MinWidth="155"/>
    </Grid>
  </Grid>
</Window>
