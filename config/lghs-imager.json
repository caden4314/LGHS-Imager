{
  "productName": "LGHS Imager",
  "organization": "LGHS",
  "platform": "windows-x64",
  "target": {
    "board": "Raspberry Pi 5",
    "imagerDeviceId": "pi5",
    "requiredMemoryGb": 4,
    "supportedMemoryGb": [4, 8],
    "architecture": "arm64"
  },
  "features": {
    "studentImage": true,
    "controllerImage": true,
    "localImage": true,
    "batchMode": true,
    "verifySha256": true,
    "verifyWrite": true,
    "telemetry": false,
    "silentSelfUpdate": false,
    "stockImageBootstrapFallback": false
  },
  "accounts": {
    "user": "lg_cs_cont",
    "admin": "cs_admin",
    "root": "root",
    "promptPerDevice": true,
    "defaultRootSameAsAdmin": true
  },
  "batch": {
    "studentPrefix": "CS-",
    "firstDevice": 1,
    "lastDevice": 14,
    "padding": 2,
    "controllerHostname": "LGCSCONT",
    "autoAdvanceAfterSuccessfulWrite": true
  },
  "repository": {
    "manifest": "https://raw.githubusercontent.com/caden4314/LGHS-Imager/main/os-list/lghs-os-list.json",
    "stockBaseImage": "https://downloads.raspberrypi.com/raspios_arm64_latest",
    "bootstrapGitRepository": "https://github.com/caden4314/LGHS-System.git",
    "bootstrapGitBranch": "main"
  },
  "fleet": {
    "deploymentKeyName": "controller_ed25519",
    "generateOnDemand": true,
    "controllerHost": "LGCSCONT-CF",
    "controllerUser": "cs_admin",
    "fleetApiUrl": "https://fleet-api.scenicrouteservers.com"
  },
  "updater": {
    "enabled": false,
    "githubRepository": "caden4314/LGHS-Imager",
    "releaseAsset": "LGHS-Imager-Setup-x64.exe",
    "checksumAsset": "LGHS-Imager-Setup-x64.exe.sha256",
    "silentInstallerArguments": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /CLOSEAPPLICATIONS /RESTARTAPPLICATIONS"
  }
}
